# ---------------------------------------------------------------------------
# Marketing Dashboard API — environment variables
# Copy to .env for local dev. In production, set these in Vercel:
#   Project → Settings → Environment Variables (Vercel does NOT read .env).
# ---------------------------------------------------------------------------

PORT=5000

# --- Database (Supabase Postgres) ---------------------------------------------
# DATABASE_URL  = POOLED connection (Supavisor), used by the app at runtime.
#                 Serverless needs pooling or it exhausts DB connections.
#                 Get it from Supabase → Project Settings → Database → Connection string → "Transaction pooler".
#   Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL    = DIRECT connection (port 5432), used only for migrations / prisma db push.
#                 Use the "Session pooler" host (IPv4-safe), NOT db.[ref].supabase.co (IPv6-only).
#   Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# For LOCAL dev against Docker Postgres, both point at localhost (no pooler needed):
DATABASE_URL="postgresql://postgres:password@localhost:5432/marketing"
DIRECT_URL="postgresql://postgres:password@localhost:5432/marketing"

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change_me_in_production

# --- Integrations -------------------------------------------------------------
# HubSpot Private App Access Token
HUBSPOT_ACCESS_TOKEN=

# Instantly AI API key
INSTANTLY_API_KEY=

# Salesforce / Account Engagement (Pardot) — pending admin provisioning.
# Consumer Key / Secret from the External Client App:
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Account Engagement API v5 also needs (add when integration is built):
#   SALESFORCE_PARDOT_BUSINESS_UNIT_ID=   # 18-char 0Uv... (one per BU)
#   SALESFORCE_REFRESH_TOKEN=             # generated once via OAuth as the integration user

# Master edit PIN — server-only, never sent to the browser. Editors type it;
# the app verifies via POST /api/access/verify. Change here to rotate.
EDIT_PIN=wave2026

# LinkedIn Developer App (Community Management API) — organic Page analytics.
# Client ID/Secret from the app's Auth tab (linkedin.com/developers/apps).
# A Page admin must click through /api/linkedin/auth once to connect it —
# there's no static API key like HubSpot/Instantly. Access tokens last 60
# days; unless this app has been granted a refresh token, that click has to
# be repeated roughly every 2 months.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a Redirect URL registered in the app's Auth tab.
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback
