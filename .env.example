# ---------------------------------------------------------------------------
# Marketing Dashboard API — environment variables
# Copy to .env for local dev. In production, set these in Vercel:
#   Project → Settings → Environment Variables (Vercel does NOT read .env).
# ---------------------------------------------------------------------------

PORT=5000

# --- Database (any Postgres) --------------------------------------------------
# Nothing here is tied to a specific provider: schema.prisma is plain
# `provider = "postgresql"` and there is no vendor SDK in the project. Switching
# hosts is these two variables and nothing else.
#
# DATABASE_URL  = POOLED connection, used by the app at runtime. Serverless opens
#                 a connection per invocation, so an unpooled URL exhausts the
#                 database's connection limit under load.
# DIRECT_URL    = DIRECT (unpooled) connection, used ONLY by prisma db push /
#                 migrate. Migrations need a real session; a pooler breaks them.
#
# DATABASE_URL is required — the app exits at startup if it is missing, rather
# than booting and failing on every query.
#
# Neon: Connect → set the ORM dropdown to "Prisma" and copy both lines verbatim.
#   DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require"
#   DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require"
#   (pooled host has -pooler, direct host does not)
#
# Supabase: Connect → Transaction pooler (6543) and Session pooler (5432).
#   Do NOT use db.[ref].supabase.co — it is IPv6-only and unreachable from Vercel.
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# Keep the app's region close to the database — see "regions" in vercel.json.
#
# LOCAL dev against Docker Postgres — both point at localhost, no pooler needed:
DATABASE_URL="postgresql://postgres:password@localhost:5432/marketing"
DIRECT_URL="postgresql://postgres:password@localhost:5432/marketing"

# --- Integrations -------------------------------------------------------------
# All of these may be left empty. Empty = that integration is switched off and
# says so at startup; it does NOT fall back to a placeholder token. Never put a
# dummy value here — a fake token gets sent to the provider and comes back 401,
# which looks like a broken integration rather than a missing key.
# HubSpot Private App Access Token
HUBSPOT_ACCESS_TOKEN=

# Instantly AI API key
INSTANTLY_API_KEY=

# Salesforce / Account Engagement (Pardot) — pending admin provisioning.
# Consumer Key / Secret from the External Client App:
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Account Engagement API v5 also needs (add when integration is built):
#   SALESFORCE_PARDOT_BUSINESS_UNIT_ID=   # 18-char 0Uv... (one per BU)
#   SALESFORCE_REFRESH_TOKEN=             # generated once via OAuth as the integration user

# Master edit PIN — server-only, never sent to the browser. Editors type it;
# the app verifies via POST /api/access/verify. Change here to rotate.
# MUST be overridden in Vercel: the value below is committed to this repo, so
# leaving it unset means anyone who can read the repo can edit the dashboard.
# The app warns at startup while it is still this default.
EDIT_PIN=wave2026

# Shared secret for the sync endpoints. While this is EMPTY, /api/cron/sync and
# the HubSpot/Instantly/LinkedIn sync write-endpoints are open to anyone who
# knows the URL. Set it in Vercel and add the same value as CRON_SECRET so
# Vercel Cron authenticates with it.
SYNC_SECRET=

# LinkedIn Developer App (Community Management API) — organic Page analytics.
# Client ID/Secret from the app's Auth tab (linkedin.com/developers/apps).
# A Page admin must click through /api/linkedin/auth once to connect it —
# there's no static API key like HubSpot/Instantly. Access tokens last 60
# days; unless this app has been granted a refresh token, that click has to
# be repeated roughly every 2 months.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Normally leave EMPTY: the callback URL is derived from the host the request
# arrived on, so localhost and production each send their own. Set it only to
# override that. Whatever is used must be registered in the app's Auth tab.
LINKEDIN_REDIRECT_URI=
# Whether LinkedIn may write rows into a quarter. Off: marketing enters Social
# Performance by hand, and LinkedIn's stats are Page-level, so a sync can only
# file them under "Unmapped (LinkedIn)" beside hand-checked numbers. Connecting
# the account, /health and the OAuth flow all work regardless. Set to true to
# let the daily cron and /api/linkedin/sync write again.
LINKEDIN_SYNC_ENABLED=false
