// Prisma Schema for Wave Tracker.
// The whole dashboard persists through a single generic key/value table.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel targets = Vercel serverless runtime (Amazon Linux)
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Supabase Supavisor :6543) used at runtime
  directUrl = env("DIRECT_URL")   // direct connection (:5432) used for migrations / db push
}

// Generic key -> JSON blob store backing the Wave Tracker frontend's
// window.storage (keys: meta, qdata:<quarter>, comments:<quarter>).
// Shared across the whole team so everyone sees the same data.
model KVStore {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
