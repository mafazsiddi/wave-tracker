// Prisma Schema for Wave Tracker.
// The whole dashboard persists through a single generic key/value table.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel targets = Vercel serverless runtime (Amazon Linux)
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

// Any Postgres host works — nothing below is provider-specific. See .env.example
// for the pooled/direct pair on Neon and Supabase.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // POOLED connection, used at runtime
  directUrl = env("DIRECT_URL")   // DIRECT (unpooled) connection, used only for migrations / db push
}

// Generic key -> JSON blob store backing the Wave Tracker frontend's
// window.storage (keys: meta, qdata:<quarter>, comments:<quarter>).
// Shared across the whole team so everyone sees the same data.
model KVStore {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Previous versions of each KVStore key, written before every change.
//
// The whole quarter lives in one blob, so a client-side bug can rewrite the
// lot - which is exactly how a batch of hand-entered rows was lost. Guards stop
// the obvious cases, but nothing stops all of them, so keep history: any loss
// becomes "restore the copy from before it happened" instead of retyping.
//
// `entries` is the row count of the blob at that moment, denormalised so the
// history list can be rendered without parsing every stored value.
model KVRevision {
  id        Int      @id @default(autoincrement())
  key       String
  value     String
  entries   Int?
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// One row per dashboard entry - the shape the quarter blob should have had.
//
// Storing a quarter as a single blob is what makes losing it possible: every
// save rewrites all ~1,500 rows, so two people editing unrelated things collide
// on everything, and one bad write takes out the lot. The version token, the
// mass-deletion guard and KVRevision are all sandbags around that one choice.
// A row per entry removes the collision instead of defending against it - two
// editors touching different rows cannot conflict at all, and a sync can be
// confined to its own rows by a WHERE clause rather than by convention.
//
// Right now this table is written but never read: the blob in KVStore is still
// the source of truth, and this is kept alongside it until it can be shown to
// reproduce that blob exactly. See entryProjection.service.ts.
//
// `data` holds the entry's full JSON so nothing is lost to a column list the
// frontend outgrows; the columns beside it are denormalised copies, there to be
// queried on. `ord` preserves the entry's position in the blob array, which the
// UI relies on for ordering. Deletes are soft - a row that vanishes is the
// thing that has repeatedly gone wrong here, so it stays recoverable.
model Entry {
  quarter   String
  id        String
  ord       Int
  channel   String?
  kind      String?
  group     String?
  country   String?
  data      String
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  @@id([quarter, id])
  @@index([quarter, deletedAt])
}
