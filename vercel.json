{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/wave-tracker", "destination": "/wave-tracker/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 6 * * *" }
  ]
}
